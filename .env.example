# Supabase project URL and anon (public) key. Safe to expose client-side —
# access is enforced by RLS, not by keeping this secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (public). The matching secret key belongs
# only in the submit-report edge function's environment, never here.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
